# ========================================================
# SafeSense AI - Environment Variables
# ========================================================
# Note: In Vercel, set these in Project Settings -> Environment Variables.
# NEVER expose GEMINI_API_KEY in client-side code!
# The serverless function in api/gemini.js reads this securely on the backend.

# Google Gemini API Key (Required for AI Emergency Assistant)
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_REAL_SECRET_KEY

# Optional: Google Maps Platform API Key (For enhanced interactive map views)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
